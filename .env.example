# Bob (MONEY TALKS 2): copy to .env and fill in. Never commit .env. scripts/bob_dev.py reads it; a deployed server sets
# the same variables in its environment. Placeholders only below.

# --- Hackathon mode: every model call goes through Nicrron, never a direct provider call
BOB_HACKATHON=1
NICRRON_API_KEY=sk-af-REPLACE_ME
# nicrron.ai/docs/models: a pinned id (provider/model) keeps runs comparable; nicrron/auto routes by prompt
NICRRON_MODEL=anthropic/claude-haiku-5-5
NICRRON_BASE_URL=https://api.nicrron.ai/v1
# how the agents' structured answer is requested: prompt (default, works everywhere), json_schema, json_object
NICRRON_STRUCTURED=prompt

# --- PRISM by Block Convey: every run of Bob, step by step (blockconvey.com/docs)
# PRISM's documented names; the older PRISM_API_KEY / PRISM_PROJECT_ID / PRISM_HOST also work
PRISMTRACE_API_KEY=pt-sk-REPLACE_ME
PRISMTRACE_PROJECT_ID=8a0c203d-6714-4e6a-bd5a-040b5e397851
PRISMTRACE_HOST=https://prism.blockconvey.com
PRISM_AGENT_ID=bob-close
PRISM_AGENT_NAME=Bob

# --- optional
# BOB_RUNS_DIR=data/bob/runs          # where every run's record (steps, PRISM's answers) is written
# BOB_V1=1                            # replay Bob v1's behaviour (reproduce the baseline batch)
# NHB_AGENT_CLASSIFIER_ENABLED=1      # the classifier is on in config/agents.json already; 0 turns it off for a run
# NEXT_PUBLIC_BRAND=Bob               # the workspace's brand in the rail (build-time, web/)
