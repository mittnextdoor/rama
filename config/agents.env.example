# Reasoning agents' API keys (docs/83 §5). Copy the names, never the values, into this Mac's Keychain (service
# nhb-product, account = the variable name) or into the server's environment. Never commit a real key.
# One key per agent, so each can be limited, rotated or revoked on its own; or one shared key for all of them.
NHB_AGENT_CLASSIFIER_API_KEY=
NHB_AGENT_REVIEWER_API_KEY=
NHB_AGENT_CLIENT_QUESTIONS_API_KEY=
# NHB_ANTHROPIC_API_KEY=          # the shared fallback, used by any agent without its own key
# Turning an agent on for one machine without editing config/agents.json:
# NHB_AGENT_CLASSIFIER_ENABLED=1
